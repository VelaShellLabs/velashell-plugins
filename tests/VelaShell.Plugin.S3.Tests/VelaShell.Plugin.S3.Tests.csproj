<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="VelaShell.PluginSdk.Testing" />
    <!-- 管理服务的单测用替身客户端驱动 IAmazonS3。 -->
    <PackageReference Include="NSubstitute" />
    <!-- 环回服务器要按收到的原始请求行重算 SigV4,因此测试项目自己也要引 SDK 的类型。
         版本与 S3 插件一致 —— 由根 Directory.Packages.props 保证。 -->
    <PackageReference Include="AWSSDK.S3" />
    <!-- 测试宿主必须显式带运行时 Avalonia；插件项目本身排除 runtime 资产，避免把宿主
         的共享程序集复制到插件目录。Ui/Mvvm.cs 的 Dispatcher 路径需要这份运行时资产。 -->
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\VelaShell.Plugin.S3\VelaShell.Plugin.S3.csproj" />
  </ItemGroup>

</Project>
