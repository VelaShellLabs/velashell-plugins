<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 面板内容工厂在替身里保持惰性,测试本身不装载 Avalonia 运行时;
         摆这一条只是让 HelloWorld 的程序集在解析引用时不缺文件。 -->
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- 示例插件 + 测试替身:这两个测试类同时也是 VelaShell.PluginSdk.Testing 的
         dogfood —— 插件作者照着它就知道"不起宿主怎么测插件"。 -->
    <PackageReference Include="VelaShell.PluginSdk.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\VelaShell.Plugin.HelloWorld\VelaShell.Plugin.HelloWorld.csproj" />
  </ItemGroup>

</Project>
