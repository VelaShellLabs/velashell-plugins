<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="VelaShell.PluginSdk.Testing" />
    <!-- 测试宿主必须显式带运行时 Avalonia；插件项目本身排除 runtime 资产，避免把宿主
         的共享程序集复制到插件目录。Ui/Mvvm.cs 的 Dispatcher 路径需要这份运行时资产。 -->
    <PackageReference Include="Avalonia" />
    <!-- 面板的 headless 装载测试:AXAML 真装载一次,样式选择器/模板/索引器绑定
         这些编译期看不出的问题才会暴露。 -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\VelaShell.Plugin.Redis\VelaShell.Plugin.Redis.csproj" />
  </ItemGroup>

</Project>
