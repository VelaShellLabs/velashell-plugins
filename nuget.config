<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear:不继承机器级 NuGet.Config 里可能存在的镜像/私有源。
         插件的依赖必须来自 nuget.org 那一份 —— 否则"本机构建过、CI 拉不到"这种缝
         会以还原失败的形式出现在别人身上。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- 本地联调未发布的 SDK。在工具链仓库(joesdu/velashell-plugin-toolchain)跑:
           dotnet pack plugin-sdk/VelaShell.PluginSdk/VelaShell.PluginSdk.csproj -c Release -o artifacts/nuget -p:VelaSdkVersion=1.5.0-dev
           dotnet pack plugin-sdk/VelaShell.PluginSdk.Build/VelaShell.PluginSdk.Build.csproj -c Release -o artifacts/nuget -p:VelaSdkVersion=1.5.0-dev
           dotnet pack plugin-sdk/VelaShell.PluginSdk.Testing/VelaShell.PluginSdk.Testing.csproj -c Release -o artifacts/nuget -p:VelaSdkVersion=1.5.0-dev
         然后把下面这行的注释去掉、路径改成你本地的工具链仓库,再:
           dotnet build VelaShell.Plugins.slnx -p:VelaSdkVersion=1.5.0-dev
         ⚠️ 改完记得注释回去再提交:本地绝对路径进了仓库,别人和 CI 一还原就报源不存在。
         另外本地源的包会被 NuGet 按版本号缓存住,重打同一个版本号要先清一次
         global-packages 缓存(dotnet nuget locals global-packages 加 clear 参数),
         或者干脆每次换一个新的 -dev 后缀,省掉这一步。 -->
    <!-- <add key="vela-toolchain-local" value="G:\velashell-plugin-toolchain\artifacts\nuget" /> -->
  </packageSources>
</configuration>
