<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear:不继承机器级 NuGet.Config 里可能存在的镜像/私有源。
         插件的依赖必须来自 nuget.org 那一份 —— 否则"本机构建过、CI 拉不到"这种缝
         会以还原失败的形式出现在别人身上。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- 本地联调未发布的 SDK。工具链在 2026-08-27 拆成了两个仓库:
           VelaShellLabs/velashell-plugin-sdk  —— VelaShell.PluginSdk / .Testing
           VelaShellLabs/velashell-plugin-cli  —— VelaShell.PluginSdk.Build / vela-plugin
         在对应仓库跑(版本旋钮各自不同,见其 Directory.Build.props):
           dotnet pack src/... -c Release -o artifacts/nuget -p:VelaSdkVersion=1.5.0-dev
           dotnet pack src/... -c Release -o artifacts/nuget -p:VelaToolsVersion=1.5.0-dev
         然后把下面这行的注释去掉、路径改成你本地那个仓库的 artifacts/nuget,
         再把 Directory.Packages.props 里对应的 PackageVersion 临时指到 1.5.0-dev。
         ⚠️ 改完记得都改回去再提交:本地绝对路径进了仓库,别人和 CI 一还原就报源不存在。
         另外本地源的包会被 NuGet 按版本号缓存住,重打同一个版本号要先清一次
         global-packages 缓存(dotnet nuget locals global-packages 加 clear 参数),
         或者干脆每次换一个新的 -dev 后缀,省掉这一步。 -->
    <!-- <add key="vela-local" value="G:\VelaShellLabs\velashell-plugin-cli\artifacts\nuget" /> -->
  </packageSources>
</configuration>
