  <!-- ── 控件主题 ──────────────────────────────────────────────────
       自带而不是依赖宿主的 ControlTheme:令牌缺失时属性只会回落默认值,面板照样成型;
       而依赖一个不存在的 ControlTheme 会让整个控件塌掉。 -->

  <!-- 工具条按钮:描边 + 图标 + 文字。危险/主要/激活三种变体在 DockerStyles.axaml 里按 class 改。 -->
  <ControlTheme x:Key="DockerToolButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.38" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- 只有图标的方形按钮(刷新、关闭、行内动作)。 -->
  <ControlTheme x:Key="DockerIconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- 对齐与内边距一律走 TemplateBinding。
             写死成 Center 的话,调用方那些 HorizontalContentAlignment="Stretch" + Padding
             会被静默吃掉 —— 拿它当整行按钮用的地方(命令面板、文件树、卷/网络列表、
             端点菜单)就会变成"每一行各自居中、宽度跟着文字长短跑"。
             默认值仍是 Center,所以纯图标按钮的行为不变。 -->
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- 左导航栏的一项:图标在上、文字在下,选中时整块药丸底 + 强调色。
       56×48 的格子里放一枚 46×42 的药丸 —— 药丸不贴边,悬停底才不会糊到导航栏边界上。 -->
  <ControlTheme x:Key="DockerRailButton" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Pill" Background="{TemplateBinding Background}" CornerRadius="8" Margin="5,3">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Pill">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Pill">
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>
  </ControlTheme>

  <!-- 导航栏底部那一项(设置)。长得和上面的导航项一模一样,但它开的是覆盖层不是页面 ——
       所以是 Button 而不是 RadioButton:它按下去不该把当前页的高亮抢走。 -->
  <ControlTheme x:Key="DockerRailActionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Pill" Background="{TemplateBinding Background}" CornerRadius="8" Margin="5,3">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Pill">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    </Style>
  </ControlTheme>

  <!-- 分段控件里的一格。 -->
  <ControlTheme x:Key="DockerSegmentButton" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Seg" Background="{TemplateBinding Background}" CornerRadius="3"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Seg">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Seg">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
    </Style>
  </ControlTheme>

  <!-- 抽屉/详情页的页签。 -->
  <ControlTheme x:Key="DockerTabButton" TargetType="RadioButton" BasedOn="{StaticResource DockerSegmentButton}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
  </ControlTheme>

  <!-- 视图开关(时间戳 / 换行 / 仅错误 / 跟随)。
       描边 = 关,强调色底 = 开。用底色而不是打勾:这三颗要在一眼扫过时读出状态。 -->
  <ControlTheme x:Key="DockerChipToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Chip" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Chip">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Chip">
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>
  </ControlTheme>

  <!-- 开关。 -->
  <ControlTheme x:Key="DockerSwitch" TargetType="ToggleButton">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Track" CornerRadius="8"
                Background="{DynamicResource VelaBgActive}"
                BorderBrush="{DynamicResource VelaBorderSecondary}"
                BorderThickness="1">
          <Ellipse Name="Knob" Width="11" Height="11" Margin="2,0"
                   HorizontalAlignment="Left"
                   Fill="{DynamicResource VelaTextTertiary}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#Knob">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Fill" Value="{DynamicResource VelaAccentForeground}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>


  <!--
    日志列表:**虚拟化**的 ItemsControl。

    面板里别处的列表都是 ItemsControl 直接塞进一个 ScrollViewer —— 几十上百行没关系。
    日志不是:合并日志留 5000 行、执行记录留 2000 行,而那种写法一行都不会省,
    每一行都实打实地建控件、测量、排版。用户看到的就是"这个页签一点开要卡一下,
    而且每次回来都要再卡一次"(其实是可见性一变就整棵重排)。

    要虚拟化,滚动条必须在**这个控件自己的模板里**:外面套一层 ScrollViewer 的话,
    ItemsControl 是在无限高里测量的,VirtualizingStackPanel 照样会把每一行都实现出来。
    这也是这份主题存在的全部理由。
  -->
  <ControlTheme x:Key="DockerLogList" TargetType="ItemsControl">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}"
                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                      VerticalScrollBarVisibility="Auto">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
