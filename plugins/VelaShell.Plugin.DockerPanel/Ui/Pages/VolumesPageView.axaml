<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VelaShell.Plugin.DockerPanel.Ui"
             xmlns:pages="clr-namespace:VelaShell.Plugin.DockerPanel.Ui.Pages"
             x:Class="VelaShell.Plugin.DockerPanel.Ui.Pages.VolumesPageView"
             x:DataType="pages:VolumesPageViewModel">

  <!--
    外层三列:列表 / 5px 分割条 / 抽屉。三列的宽度由 DrawerLayout 在开关、最大化、拖动时设,
    与容器页、宿主侧栏是同一套。
  -->
  <Grid x:Name="Root" ColumnDefinitions="*,0,0">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" IsVisible="{Binding Drawer.ListVisible}">

      <Border Grid.Row="0" Classes="toolbar">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Text="卷" Classes="h1" />
          <TextBlock Grid.Column="1" Text="{Binding TotalCount}" Classes="meta" Margin="8,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding TotalSizeText}" Classes="meta" Margin="10,0,0,0" />

          <!-- 「只看未使用」的筛选逻辑早就写好了(UnusedOnly),却一直没有开关 ——
               而清理卷之前想先看看会清掉哪些,正是这一页最常见的一件事。 -->
          <ToggleButton Grid.Column="3" Theme="{StaticResource DockerChipToggle}" Margin="12,0,0,0"
                        ToolTip.Tip="只留没有容器挂着的卷 —— 也就是「清理未使用」会动的那些"
                        IsChecked="{Binding UnusedOnly}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.list-filter" Size="12" Brush="{Binding $parent[ToggleButton].Foreground}" />
              <TextBlock Text="{Binding UnusedCount, StringFormat='只看未使用 {0}'}"
                         FontSize="{DynamicResource VelaFontSize11}" VerticalAlignment="Center"
                         Foreground="{Binding $parent[ToggleButton].Foreground}" />
            </StackPanel>
          </ToggleButton>

          <Border Grid.Column="4" Classes="input" Width="200" Height="26" Margin="12,0,0,0" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="Auto,*">
              <ui:Glyph Grid.Column="0" Key="Icon.search" Size="12" Brush="{DynamicResource VelaTextTertiary}" />
              <TextBox Grid.Column="1" Classes="bare" Margin="7,0,0,0" Text="{Binding Search}"
                       PlaceholderText="按卷名或项目过滤…" />
            </Grid>
          </Border>

          <Button Grid.Column="5" Theme="{StaticResource DockerToolButton}" Margin="0,0,8,0"
                  BorderBrush="{DynamicResource VelaShellRedDim}" Command="{Binding PruneCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.shield-alert" Size="13" Brush="{DynamicResource VelaError}" />
              <TextBlock Text="{Binding UnusedCount, StringFormat='清理未使用 ({0})'}"
                         FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaError}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="6" Theme="{StaticResource DockerToolButton}" Classes="primary" Margin="0,0,9,0"
                  Command="{Binding CreateCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Icon.plus" Size="13" Brush="{DynamicResource VelaAccentForeground}" />
              <TextBlock Text="新建卷…" FontSize="{DynamicResource VelaFontSize11}" FontWeight="Medium"
                         Foreground="{DynamicResource VelaAccentForeground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="7" Theme="{StaticResource DockerIconButton}" Width="26" Height="26"
                  ToolTip.Tip="刷新(F5)" Command="{Binding RefreshCommand}">
            <ui:Glyph Key="Icon.refresh-cw" Size="14" Brush="{DynamicResource VelaTextTertiary}" />
          </Button>
        </Grid>
      </Border>
      <!--
        列头。列宽是一组 GridLength(Columns),列头与每一行的 ColumnDefinitions 绑同一份;
        每列右边一条 6px 轨道 = 1px 细线 + 透明抓取区,拖动改列宽、双击按内容自适应。
        默认宽度取自设计稿 07 号板的表头。
      -->
      <Border Grid.Row="1" Classes="header-row" ClipToBounds="True">
        <Grid x:Name="HeaderGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Columns.Name}" MinWidth="160" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="{Binding Columns.Driver}" MinWidth="70" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="{Binding Columns.Users}" MinWidth="90" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="{Binding Columns.Size}" MinWidth="62" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="{Binding Columns.Created}" MinWidth="70" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="104" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="名称" Classes="col" Margin="12,0,6,0" />
          <Border Grid.Column="1" Classes="colgrip" Tag="name">
            <Border Classes="colline" />
          </Border>
          <TextBlock Grid.Column="2" Text="驱动" Classes="col" Margin="0,0,6,0" />
          <Border Grid.Column="3" Classes="colgrip" Tag="driver">
            <Border Classes="colline" />
          </Border>
          <TextBlock Grid.Column="4" Text="使用者" Classes="col" Margin="0,0,6,0" />
          <Border Grid.Column="5" Classes="colgrip" Tag="users">
            <Border Classes="colline" />
          </Border>
          <TextBlock Grid.Column="6" Text="大小" Classes="col" Margin="0,0,6,0" />
          <Border Grid.Column="7" Classes="colgrip" Tag="size">
            <Border Classes="colline" />
          </Border>
          <TextBlock Grid.Column="8" Text="创建" Classes="col" Margin="0,0,6,0" />
          <Border Grid.Column="9" Classes="colgrip" Tag="created">
            <Border Classes="colline" />
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Background="{DynamicResource VelaBgSurface}">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding View}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ui:VolumeRow">
                <Button Theme="{StaticResource DockerIconButton}" Width="NaN" Height="NaN" CornerRadius="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"
                        Command="{Binding $parent[ItemsControl].((pages:VolumesPageViewModel)DataContext).SelectCommand}"
                        CommandParameter="{Binding}">
                  <!-- 列定义与列头**逐字一致**,宽度回绑列头那份 Columns —— 两处必须一起改。
                       6px 的那几列是列头上拖拽轨道的位置,行里只留出同样的空当。 -->
                  <Grid Height="32" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding Owner.Columns.Name}" MinWidth="160" />
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="{Binding Owner.Columns.Driver}" MinWidth="70" />
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="{Binding Owner.Columns.Users}" MinWidth="90" />
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="{Binding Owner.Columns.Size}" MinWidth="62" />
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="{Binding Owner.Columns.Created}" MinWidth="70" />
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" Margin="12,0,6,0"
                                VerticalAlignment="Center" ClipToBounds="True">
                      <ui:Glyph Key="Docker.database" Size="13"
                                Brush="{Binding Tone, Converter={x:Static ui:Converters.ToneBrush}}" />
                      <TextBlock Text="{Binding Name}" Classes="name" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Driver}" Classes="cell" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="4" Text="{Binding UsageText}" Classes="cell" Margin="0,0,6,0"
                               Foreground="{Binding Tone, Converter={x:Static ui:Converters.ToneBrush}}" />
                    <TextBlock Grid.Column="6" Text="{Binding SizeText}" Classes="cell" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="8" Text="{Binding CreatedText}" Classes="cell" Margin="0,0,6,0" />
                    <!-- 行尾动作钉在最右:第 10 列是填充列,富余的宽度全归它 -->
                    <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Right"
                                Margin="0,0,6,0" VerticalAlignment="Center">
                      <Button Theme="{StaticResource DockerIconButton}" Width="22" Height="22"
                              ToolTip.Tip="浏览卷内文件"
                              Command="{Binding $parent[ItemsControl].((pages:VolumesPageViewModel)DataContext).BrowseCommand}"
                              CommandParameter="{Binding}">
                        <ui:Glyph Key="Icon.folder-open" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
                      </Button>
                      <Button Theme="{StaticResource DockerIconButton}" Width="22" Height="22" ToolTip.Tip="删除…"
                              Command="{Binding $parent[ItemsControl].((pages:VolumesPageViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <ui:Glyph Key="Icon.trash-2" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="这台机器上还没有卷" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="容器把数据写在可写层里,容器一删就没了 —— 要留住数据就得有卷。" Classes="hint"
                     TextAlignment="Center" MaxWidth="360" />
          <!-- 空状态得给出下一步:镜像页的空状态有「拉取镜像…」,这里原来只有两行字。 -->
          <Button Theme="{StaticResource DockerToolButton}" Classes="primary" Height="28"
                  HorizontalAlignment="Center" Command="{Binding CreateCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Icon.plus" Size="12" Brush="{DynamicResource VelaAccentForeground}" />
              <TextBlock Text="新建卷…" FontSize="{DynamicResource VelaFontSize11}" FontWeight="Medium"
                         Foreground="{DynamicResource VelaAccentForeground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock IsVisible="{Binding NoMatch}" Classes="hint"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="没有匹配的卷 —— 换个词,或者把「只看未使用」关掉。" />
      </Grid>
    </Grid>

    <!-- 详情抽屉。与容器 / 镜像抽屉同一副骨架:标题条 / 动作条 / 内容,
         这样在四个页面之间来回切时,"关闭在哪、主动作在哪"永远是同一个位置。 -->
    <!-- 抽屉分割条:5px 透明抓取区上画一条 1px 细线 —— 与宿主侧栏、文件面板同款。 -->
    <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
            IsVisible="{Binding Drawer.CanResize}"
            Background="{DynamicResource VelaBorderPrimary}" />
    <GridSplitter Grid.Column="1" x:Name="DrawerSplitter" Background="Transparent"
                  ResizeDirection="Columns" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  IsVisible="{Binding Drawer.CanResize}" ToolTip.Tip="拖动改抽屉宽度" />

    <Border Grid.Column="2" ClipToBounds="True" IsVisible="{Binding HasSelection}"
            Background="{DynamicResource VelaBgContentHeader}"
            BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1,0,0,0">
      <DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding Selected}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="ui:VolumeRow">
              <Border Height="44" Padding="14,0"
                      BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                  <ui:Glyph Grid.Column="0" Key="Docker.database" Size="15" VerticalAlignment="Center"
                            Brush="{DynamicResource VelaAccent}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="h2" Margin="8,0,0,0" />
                  <Border Grid.Column="2" Classes="chip" Margin="8,0,0,0"
                          Background="{Binding Tone, Converter={x:Static ui:Converters.ToneBrush}, ConverterParameter=dim}">
                    <TextBlock Text="{Binding UsageText}" FontSize="{DynamicResource VelaFontSize10}"
                               Foreground="{Binding Tone, Converter={x:Static ui:Converters.ToneBrush}}"
                               VerticalAlignment="Center" />
                  </Border>
                  <!-- 铺开 / 还原与关闭并排,位置与容器、镜像抽屉一致。 -->
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                    <Button Theme="{StaticResource DockerIconButton}" Width="26" Height="26"
                            ToolTip.Tip="最大化 / 还原"
                            Command="{Binding $parent[UserControl].((pages:VolumesPageViewModel)DataContext).Drawer.ToggleMaximizeCommand}">
                      <ui:Glyph Size="14" Brush="{DynamicResource VelaTextTertiary}"
                                Key="{Binding $parent[UserControl].((pages:VolumesPageViewModel)DataContext).Drawer.Maximized, Converter={x:Static ui:Converters.MaximizeIcon}}" />
                    </Button>
                    <Button Theme="{StaticResource DockerIconButton}" Width="26" Height="26"
                            ToolTip.Tip="关闭"
                            Command="{Binding $parent[UserControl].((pages:VolumesPageViewModel)DataContext).ClearSelectionCommand}">
                      <ui:Glyph Key="Icon.x" Size="14" Brush="{DynamicResource VelaTextTertiary}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <Border DockPanel.Dock="Top" Height="42" Padding="14,0"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Theme="{StaticResource DockerToolButton}"
                    Background="{DynamicResource VelaAccentDim}" BorderBrush="Transparent"
                    IsEnabled="{Binding CanBrowse}"
                    ToolTip.Tip="{Binding BrowseHint, Converter={x:Static ui:Converters.TipText}}"
                    Command="{Binding BrowseCommand}" CommandParameter="{Binding Selected}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Glyph Key="Icon.folder-open" Size="13" Brush="{DynamicResource VelaAccent}" />
                <TextBlock Text="浏览卷内文件" FontSize="{DynamicResource VelaFontSize11}"
                           Foreground="{DynamicResource VelaAccent}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- 备份走的是浏览那条路:借一个挂着它的运行中容器,把挂载点整包取成 tar -->
            <Button Theme="{StaticResource DockerToolButton}" IsEnabled="{Binding CanBackup}"
                    ToolTip.Tip="把卷里的内容整包存成本地 tar"
                    Command="{Binding BackupCommand}" CommandParameter="{Binding Selected}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Glyph Key="Icon.download" Size="13" Brush="{DynamicResource VelaTextSecondary}" />
                <TextBlock Text="备份为 tar…" FontSize="{DynamicResource VelaFontSize11}"
                           Foreground="{DynamicResource VelaTextSecondary}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

      <ScrollViewer>
        <StackPanel Margin="14,12" Spacing="10">
          <!-- 选中卷自己的那几格走 ContentControl:没选中时 Selected 是 null,
               而 IsVisible 只是不画,子树照样建、绑定照样求值。模板在 Content 为 null 时
               根本不实例化,既没有空绑定,行对象更新时又照样能推过来。 -->
          <ContentControl Content="{Binding Selected}">
            <ContentControl.ContentTemplate>
              <DataTemplate DataType="ui:VolumeRow">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*" Height="24">
                    <TextBlock Grid.Column="0" Text="基本信息" Classes="h4" />
                  </Grid>
                  <Grid ColumnDefinitions="80,*" Height="22">
                    <TextBlock Grid.Column="0" Text="驱动" Classes="label" />
                    <TextBlock Grid.Column="1" Text="{Binding Driver}" Classes="cell" />
                  </Grid>
                  <Grid ColumnDefinitions="80,*">
                    <TextBlock Grid.Column="0" Text="挂载点" Classes="label" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Mountpoint}" Classes="cell" TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="80,*" Height="22">
                    <TextBlock Grid.Column="0" Text="大小" Classes="label" />
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="cell" />
                  </Grid>
                  <Grid ColumnDefinitions="80,*" Height="22">
                    <TextBlock Grid.Column="0" Text="创建于" Classes="label" />
                    <TextBlock Grid.Column="1" Text="{Binding CreatedText}" Classes="cell" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <Border Classes="divider" />
          <TextBlock Text="使用者" Classes="h4" />
          <ItemsControl ItemsSource="{Binding SelectedUsers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="cell" Margin="0,0,0,3" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding BrowseHint}" Classes="hint" />

          <Border Classes="divider" />
          <TextBlock Text="标签" Classes="h4" />
          <ItemsControl ItemsSource="{Binding SelectedLabels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:DetailField">
                <Grid ColumnDefinitions="106,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="label"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key, Converter={x:Static ui:Converters.TipText}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="cell" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="(无)" Classes="hint" IsVisible="{Binding !SelectedLabels.Count}" />

          <Border Classes="divider" />
          <TextBlock Text="驱动选项" Classes="h4" />
          <ItemsControl ItemsSource="{Binding SelectedOptions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:DetailField">
                <Grid ColumnDefinitions="106,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="label" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="cell" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="使用默认 local 驱动" Classes="hint" IsVisible="{Binding !SelectedOptions.Count}" />

          <!-- 危险区:删卷永远是"会丢数据"那一档 -->
          <Border CornerRadius="6" Padding="12,10" Background="{DynamicResource VelaShellRedDim}"
                  BorderBrush="{DynamicResource VelaError}" BorderThickness="1">
            <StackPanel Spacing="7">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ui:Glyph Key="Icon.triangle-alert" Size="13" Brush="{DynamicResource VelaError}" />
                <TextBlock Text="危险操作" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold"
                           Foreground="{DynamicResource VelaError}" />
              </StackPanel>
              <TextBlock Text="删除卷会永久丢失里面的数据,且无法撤销。确认框中需手打 delete。"
                         FontSize="{DynamicResource VelaFontSize10}"
                         Foreground="{DynamicResource VelaError}" TextWrapping="Wrap" LineHeight="16" />
              <Button Theme="{StaticResource DockerToolButton}" Height="26"
                      BorderBrush="{DynamicResource VelaError}"
                      Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:Glyph Key="Icon.trash-2" Size="12" Brush="{DynamicResource VelaError}" />
                  <TextBlock Text="删除卷…" FontSize="{DynamicResource VelaFontSize11}"
                             Foreground="{DynamicResource VelaError}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
