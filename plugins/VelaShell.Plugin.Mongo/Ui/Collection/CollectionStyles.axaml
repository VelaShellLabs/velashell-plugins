<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:VelaShell.Plugin.Mongo.Ui">

  <!--
    集合工作台自己的几样版式(网格单元格的状态色、树行、JSON 卡片、右键菜单)。
    只服务于 Ui/Collection 下的视图;通用的按钮 / 文字 / 容器类一律用 MongoStyles.axaml 里的,不在这里另起一套。
    单元格状态照设计稿 09「网格单元格状态」:28px 行 · 单元格右侧 1px 分隔 · 暂存状态用 2px 左边条 + 淡底。
  -->

  <!-- 单元格 / 字段内联编辑的无边框文本框(配 MongoTextBox 主题用;外框由所在格子画)。 -->
  <Style Selector="TextBox.inline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 查询栏的输入框:聚焦描强调色(设计稿 01 的筛选框),写错描红。 -->
  <Style Selector="Border.input:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="Border.input.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
  </Style>

  <!-- ══ 网格:行 ══════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.grow">
    <Setter Property="Height" Value="28" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.grow.del">
    <Setter Property="Background" Value="{ui:Dim VelaError, 0.12}" />
  </Style>
  <Style Selector="Border.grow.new">
    <Setter Property="Background" Value="{ui:Dim VelaStatusConnected, 0.1}" />
  </Style>
  <!-- 待删除:内容 55% 不透明(行号格除外 —— 它要清楚地挂着那个红色减号)。 -->
  <Style Selector="Border.grow.del ItemsControl.cells">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- 行号格:40px 右对齐;选中行左侧 2px 强调条 + 强调色数字。 -->
  <Style Selector="Border.rownum">
    <Setter Property="Width" Value="40" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="4,0,8,0" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.rownum">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    <Setter Property="BorderThickness" Value="2,0,1,0" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.rownum TextBlock.num">
    <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
  </Style>

  <!-- ══ 网格:单元格 ════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.gcell">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- 已修改(待提交):橙色淡底 + 左 2px 橙条。 -->
  <Style Selector="Border.gcell.mod">
    <Setter Property="Background" Value="{ui:Dim VelaWarning, 0.12}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaWarning}" />
    <Setter Property="BorderThickness" Value="2,0,1,0" />
    <Setter Property="Padding" Value="6,0,8,0" />
  </Style>
  <Style Selector="Border.gcell.mod TextBlock">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- 当前格(选中行里键盘编辑落点):一圈很淡的强调色,不与"编辑中"的实描边混淆。 -->
  <Style Selector="ListBoxItem:selected Border.gcell.current">
    <Setter Property="BorderBrush" Value="{ui:Dim VelaAccent, 0.45}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <!-- 编辑中:输入底 + 1px 强调色描边。 -->
  <Style Selector="Border.gcell.editing">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <Style Selector="Border.gcell.editing.bad">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
  </Style>
  <Style Selector="TextBlock.uif">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
  </Style>
  <Style Selector="TextBlock.nil">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <!-- 列头格。 -->
  <Style Selector="Border.hcell">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Button.hbtn">
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- ══ 树视图行 ════════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.trow">
    <Setter Property="Height" Value="26" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.trow.doc">
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
  </Style>
  <Style Selector="Border.trow.mod">
    <Setter Property="Background" Value="{ui:Dim VelaWarning, 0.12}" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.trow">
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
  </Style>
  <Style Selector="Border.tkey">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.trow.mod Border.tkey">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaWarning}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="Border.trow.mod TextBlock.key">
    <Setter Property="Foreground" Value="{DynamicResource VelaWarning}" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.trow Border.tkey">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.trow TextBlock.key">
    <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- ══ 检查器 / 大纲的行 ═══════════════════════════════════════════════════════
       选中行只在字段列表拿着焦点时着色:焦点一离开(点回网格、换了一份文档)就不再留那块与悬停同色的底 ——
       留着像是还在被操作,而且换文档后它会落在新文档的同名字段上。选中本身还在,焦点回来就又亮。 -->
  <Style Selector="ListBox.flat ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
  </Style>
  <Style Selector="ListBox.flat:focus-within ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
  </Style>
  <Style Selector="Border.typetag">
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.typetag.on">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="Border.typetag TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize9}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.typetag.on TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="Border.fieldedit">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.fieldedit.bad">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
  </Style>
  <Style Selector="Border.outline.cur">
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
  </Style>

  <!-- ══ JSON 卡片 ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.jcard">
    <Setter Property="Background" Value="{DynamicResource VelaBgTerminal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.jcard.editing">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="Border.jhead">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.jcard.editing Border.jhead">
    <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
  </Style>
  <!-- 卡片头部的小操作(图标 11 + 文字 10,高 22)。 -->
  <Style Selector="Button.mini">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
  </Style>

  <!-- ══ 空态 / 无结果 / 长查询 ═══════════════════════════════════════════════════ -->
  <Style Selector="StackPanel.state">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.state > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ══ 右键菜单(设计稿 13:BgSurface 底、6px 圆角、4px 内边距、26px 行) ══════════ -->
  <Style Selector="ContextMenu.cw">
    <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="240" />
  </Style>
  <Style Selector="ContextMenu.cw MenuItem">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
  </Style>
  <Style Selector="ContextMenu.cw MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
  </Style>
  <Style Selector="ContextMenu.cw MenuItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
  </Style>
  <Style Selector="ContextMenu.cw MenuItem.danger">
    <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
  </Style>
  <Style Selector="ContextMenu.cw MenuItem.hint">
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="ContextMenu.cw Separator">
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource VelaBorderPrimary}" />
  </Style>
</Styles>
