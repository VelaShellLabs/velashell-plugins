<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:VelaShell.Plugin.Mongo.Ui">

  <!--
    MongoDB 工作台的一整套版式。单放一份,理由与 Redis 插件的 RedisPanelStyles 相同:
    1. 二十来块界面共用它 —— 同一个按钮在两处长得不一样,正是"各写各的样式"造成的;
    2. **可以脱离连接单独装载**:headless 测试直接 Load 这份资源验它写坏了没有。

    几何与配色按宿主 DESIGN.md:36px 文档头 / 26px 列头 / 28px 行 / 24px 状态条,
    主操作半透明药丸、次操作描边、危险操作红色描边(从不实心红),
    颜色一律 {DynamicResource VelaXxx};设计稿的 *Dim 淡底用 {ui:Dim …} 从宿主令牌现算。
  -->

  <!-- AvaloniaEdit 的控件模板随它自己的主题提供:缺了它 TextEditor 没有模板、整块空白。
       宿主的 App.axaml 全局引了这一份,这里再引一次是为了脱离宿主也能用(headless 测试、
       将来宿主不再全局引它时)—— 重复引入只是多一份同样的样式,没有副作用。 -->
  <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VelaShell.Plugin.Mongo/Ui/MongoTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- ══ Navicat 大图标工具栏的一格:18px 图标在上、10px 文字在下,50/62×46,激活 VelaBgHover 底 ══ -->
      <ControlTheme x:Key="MongoBigToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Pill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Pill">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^.active /template/ Border#Pill">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^.active">
          <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </ControlTheme>

      <!-- ══ 36px 工具行里的文字按钮(图标 12 + 文字 11,高 24,悬停 VelaBgHover)══ -->
      <ControlTheme x:Key="MongoToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bg">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.38" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- ══ 只有图标的方形按钮(24×24) ══ -->
      <ControlTheme x:Key="MongoIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bg">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.35" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- ══ 主操作:半透明药丸(VelaAccentDim 底 + VelaAccent 字),DESIGN.md §5.1 ══ -->
      <ControlTheme x:Key="MongoPillButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
        <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bg">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Bg">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- ══ 次操作:描边(透明底 + VelaBorderPrimary 1px + VelaTextSecondary 字),高 28 ══ -->
      <ControlTheme x:Key="MongoOutlineButton" TargetType="Button" BasedOn="{StaticResource MongoPillButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style Selector="^:pointerover /template/ Border#Bg">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
          <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
        </Style>
      </ControlTheme>

      <!-- ══ 危险操作:红色描边,从不实心红 ══ -->
      <ControlTheme x:Key="MongoDangerButton" TargetType="Button" BasedOn="{StaticResource MongoPillButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style Selector="^:pointerover /template/ Border#Bg">
          <Setter Property="Background" Value="{ui:Dim VelaError, 0.12}" />
          <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
        </Style>
      </ControlTheme>

      <!-- ══ 分段控件里的一格(外框由调用方给:1px 描边 + 1px 内边距 + 圆角 3) ══ -->
      <ControlTheme x:Key="MongoSegment" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Seg" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Seg">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Seg">
          <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
        </Style>
      </ControlTheme>

      <!-- ══ 下划线页签(检查器的 字段 / JSON / 集合信息;集合设计的 索引 / Schema / …) ══ -->
      <ControlTheme x:Key="MongoUnderlineTab" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid RowDefinitions="*,2" Background="Transparent">
              <ContentPresenter Grid.Row="0" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              <Border Name="Bar" Grid.Row="1" Background="Transparent" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Bar">
          <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
        </Style>
      </ControlTheme>

      <!-- ══ 开关(设计稿 09:28×16,开 = AccentDim 轨 + Accent 钮,关 = BgActive 轨 + TextTertiary 钮) ══ -->
      <ControlTheme x:Key="MongoSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Track" CornerRadius="8" Padding="2" Background="{DynamicResource VelaBgActive}">
              <Ellipse Name="Knob" Width="12" Height="12" HorizontalAlignment="Left"
                       Fill="{DynamicResource VelaTextTertiary}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Track">
          <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Knob">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="Fill" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- 小号(工具栏「读写」开关里那颗:24×14、钮 10)。 -->
        <Style Selector="^.small">
          <Setter Property="Width" Value="24" />
          <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="^.small /template/ Ellipse#Knob">
          <Setter Property="Width" Value="10" />
          <Setter Property="Height" Value="10" />
        </Style>
      </ControlTheme>

      <!-- ══ 过滤芯片(全部 13 / 集合 9 / 视图 2):开 = AccentDim 底 + Accent 字 ══ -->
      <ControlTheme x:Key="MongoChip" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Chip">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Chip">
          <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
        </Style>
      </ControlTheme>

      <!-- ══ 复选框(14px 方块,勾选 = 实心 Accent 底 + AccentForeground 勾) ══ -->
      <ControlTheme x:Key="MongoCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
              <Border Name="Box" Width="14" Height="14" CornerRadius="2" BorderThickness="1"
                      BorderBrush="{DynamicResource VelaBorderSecondary}" Background="Transparent"
                      VerticalAlignment="Center">
                <ui:Glyph Name="Tick" Key="Mongo.check" Size="11" Brush="{DynamicResource VelaAccentForeground}" IsVisible="False" />
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <!-- 勾选态是实心强调色 + 深色勾(设计稿 10 / 17 / 19 的复选框),不是淡底。 -->
        <Style Selector="^:checked /template/ Border#Box">
          <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:checked /template/ ui|Glyph#Tick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Box">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>

      <!-- ══ 输入框(VelaBgInput 底 + 1px VelaBorderPrimary,圆角 3,等宽 11;聚焦描 Accent) ══ -->
      <ControlTheme x:Key="MongoTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="CaretBrush" Value="{DynamicResource VelaAccent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource VelaAccentDim}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource VelaTextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <Panel>
                <TextBlock Name="PART_Watermark" Text="{TemplateBinding PlaceholderText}"
                           Foreground="{DynamicResource VelaTextMuted}" FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           IsHitTestVisible="False" IsVisible="False" />
                <ScrollViewer Name="PART_ScrollViewer"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                  <TextPresenter Name="PART_TextPresenter"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 CaretIndex="{TemplateBinding CaretIndex}"
                                 SelectionStart="{TemplateBinding SelectionStart}"
                                 SelectionEnd="{TemplateBinding SelectionEnd}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 LineHeight="{TemplateBinding LineHeight}"
                                 PasswordChar="{TemplateBinding PasswordChar}"
                                 RevealPassword="{TemplateBinding RevealPassword}"
                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                 SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                 CaretBrush="{TemplateBinding CaretBrush}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ScrollViewer>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:empty /template/ TextBlock#PART_Watermark">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus /template/ Border#Frame">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:error /template/ Border#Frame">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
        </Style>
        <Style Selector="^.invalid /template/ Border#Frame">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
          <Setter Property="Background" Value="{ui:Dim VelaError, 0.12}" />
        </Style>
        <Style Selector="^.modified /template/ Border#Frame">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaWarning}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.55" />
        </Style>
      </ControlTheme>

      <!-- ══ 表格列头的列宽拖把:透明,只要一个 ↔ 光标;拖动改宽,双击按内容自动适配(TableColumns / 各网格接线) ══ -->
      <ControlTheme x:Key="MongoColumnGrip" TargetType="Thumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Margin" Value="0,0,-3,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ZIndex" Value="10" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- ══ 月历(日期弹层 DatePickFlyout、文档编辑器的日历按钮)══════════════════════════
           Fluent 的月历是按触屏量的:40px 一格、20 号字、近黑的表头、选中 / 今天是系统强调蓝 ——
           放进 VelaBgSurface 的浮层里像一块别家的控件。这里整套换掉:
           · 一格 30×26、行距 28(DESIGN.md 的 28px 行),日期数字 VelaUiMonoFont 11,星期 10 号 VelaTextTertiary;
           · 今天 = VelaAccent 1px 描边;选中 = VelaAccentDim 底 + VelaAccent 字(同主操作药丸、分段选中);
           · 不在本月的日子退成 VelaTextMuted;表头是月份标题(点它进年 / 十年视图)+ 两颗 lucide 箭头。
           四个主题都按**类型**作键:日格(CalendarDayButton)与月格(CalendarButton)是 CalendarItem 在代码里
           new 出来的,只能靠隐式主题够到;Calendar / CalendarItem 一并按类型,插件里任何一处 new Calendar()
           都自动是这一套,调用点不用接线。作用域只到引了本文件的视图(浮层的逻辑父是锚点),不碰宿主。 -->
      <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton">
        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
        </Style>
        <Style Selector="^:inactive">
          <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
        </Style>
        <Style Selector="^:blackout">
          <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
        </Style>
        <Style Selector="^:today">
          <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <!-- 排在悬停 / 按下之后:选中那一格悬停时仍是选中底,只补一圈描边作反馈。 -->
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
          <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^:selected:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- 年视图的月格 / 十年视图的年格:同一套状态色,字用 VelaUiFont("1月"、"2026")。
           格子钉 36 高、在 63 高的行里居中:撑满一整行的话,选中那一格是一大块紫底,比月视图重得多。 -->
      <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
        </Style>
        <Style Selector="^:inactive">
          <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
          <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^:selected:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
      </ControlTheme>

      <!-- 表头的月份标题:工具行文字按钮的手感,字换成 12 号 SemiBold 主文字色。
           十年视图里它会被禁用(没有更上一层),那时不该变灰 —— 它仍是这一屏的标题。 -->
      <ControlTheme x:Key="MongoCalendarHeader" TargetType="Button" BasedOn="{StaticResource MongoToolButton}">
        <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </ControlTheme>

      <!-- 7 列 × 32 = 224 宽;月视图 22(星期)+ 6 × 28 = 190 高,年视图钉同一高度,切视图时弹层不跳。 -->
      <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
        <Setter Property="DayTitleTemplate">
          <Template x:DataType="x:String">
            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource VelaUiFont}" FontSize="{DynamicResource VelaFontSize10}"
                       Foreground="{DynamicResource VelaTextTertiary}" />
          </Template>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Width="224" RowDefinitions="28,Auto">
              <DockPanel>
                <Button Name="PART_NextButton" DockPanel.Dock="Right" Theme="{StaticResource MongoIconButton}">
                  <ui:Glyph Key="Mongo.chevron-right" Size="14" Brush="{DynamicResource VelaTextSecondary}" />
                </Button>
                <Button Name="PART_PreviousButton" DockPanel.Dock="Right" Theme="{StaticResource MongoIconButton}">
                  <ui:Glyph Key="Mongo.chevron-left" Size="14" Brush="{DynamicResource VelaTextSecondary}" />
                </Button>
                <Button Name="PART_HeaderButton" Theme="{StaticResource MongoCalendarHeader}" />
              </DockPanel>
              <Grid Name="PART_MonthView" Grid.Row="1" Margin="0,4,0,0" IsVisible="False"
                    RowDefinitions="22,28,28,28,28,28,28" ColumnDefinitions="*,*,*,*,*,*,*" />
              <Grid Name="PART_YearView" Grid.Row="1" Margin="0,4,0,0" Height="190" IsVisible="False"
                    RowDefinitions="*,*,*" ColumnDefinitions="*,*,*,*" />
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- 透明底:月历直接坐在浮层的 VelaBgSurface 上,不再自带一层框。 -->
      <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Name="PART_Root">
              <CalendarItem Name="PART_CalendarItem" Background="{TemplateBinding Background}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ══ 面板分隔条(可拖) ═══════════════════════════════════════════════════════
       放在宽 / 高为 0 的那一列 / 行里,左右(上下)各探出 3px 盖住相邻面板本来就有的 1px 边线:
       看上去仍是那条线,抓取区却有 6px。颜色不画 —— 线由两侧面板自己的边框给,拖条只管手感。 -->
  <Style Selector="GridSplitter.vsplit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Margin" Value="-3,0" />
    <Setter Property="ZIndex" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.hsplit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeDirection" Value="Rows" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Margin" Value="0,-3" />
    <Setter Property="ZIndex" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.vsplit:pointerover, GridSplitter.hsplit:pointerover">
    <Setter Property="Background" Value="{ui:Dim VelaAccent, 0.35}" />
  </Style>

  <!-- ══ 文字 ═════════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBlock.ui">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" /></Style>
  <Style Selector="TextBlock.tiny"><Setter Property="FontSize" Value="{DynamicResource VelaFontSize9}" /></Style>
  <Style Selector="TextBlock.big"><Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" /></Style>
  <Style Selector="TextBlock.h">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- 列头:10px、VelaTextMuted、等宽(DESIGN.md §3 Conventions)。 -->
  <Style Selector="TextBlock.col">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.primary"><Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" /></Style>
  <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" /></Style>
  <Style Selector="TextBlock.tertiary"><Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" /></Style>
  <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource VelaAccent}" /></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource VelaWarning}" /></Style>
  <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{DynamicResource VelaError}" /></Style>
  <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{DynamicResource VelaStatusConnected}" /></Style>
  <Style Selector="TextBlock.info"><Setter Property="Foreground" Value="{DynamicResource VelaInfo}" /></Style>
  <Style Selector="TextBlock.medium"><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="TextBlock.semibold"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.trim"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>

  <!-- BSON 类型色(设计稿 09)。 -->
  <Style Selector="TextBlock.t-oid"><Setter Property="Foreground" Value="{DynamicResource VelaShellBlue}" /></Style>
  <Style Selector="TextBlock.t-str"><Setter Property="Foreground" Value="{DynamicResource VelaShellCyan}" /></Style>
  <Style Selector="TextBlock.t-num"><Setter Property="Foreground" Value="{DynamicResource VelaShellGreen}" /></Style>
  <Style Selector="TextBlock.t-bool"><Setter Property="Foreground" Value="{DynamicResource VelaShellYellow}" /></Style>
  <Style Selector="TextBlock.t-date"><Setter Property="Foreground" Value="{DynamicResource VelaShellMagenta}" /></Style>
  <Style Selector="TextBlock.t-doc"><Setter Property="Foreground" Value="{DynamicResource VelaWarning}" /></Style>
  <Style Selector="TextBlock.t-null">
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="TextBlock.t-missing"><Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" /></Style>

  <!-- ══ 徽章 / 标签(圆角 2,内边距 [1,6],9px Medium) ═════════════════════════ -->
  <Style Selector="Border.tag">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
  </Style>
  <Style Selector="Border.tag > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize9}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag.warn"><Setter Property="Background" Value="{ui:Dim VelaWarning, 0.12}" /></Style>
  <Style Selector="Border.tag.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource VelaWarning}" /></Style>
  <Style Selector="Border.tag.info"><Setter Property="Background" Value="{ui:Dim VelaInfo, 0.1}" /></Style>
  <Style Selector="Border.tag.info > TextBlock"><Setter Property="Foreground" Value="{DynamicResource VelaInfo}" /></Style>
  <Style Selector="Border.tag.err"><Setter Property="Background" Value="{ui:Dim VelaError, 0.12}" /></Style>
  <Style Selector="Border.tag.err > TextBlock"><Setter Property="Foreground" Value="{DynamicResource VelaError}" /></Style>
  <Style Selector="Border.tag.ok"><Setter Property="Background" Value="{ui:Dim VelaStatusConnected, 0.1}" /></Style>
  <Style Selector="Border.tag.ok > TextBlock"><Setter Property="Foreground" Value="{DynamicResource VelaStatusConnected}" /></Style>
  <Style Selector="Border.tag.muted"><Setter Property="Background" Value="{DynamicResource VelaBgActive}" /></Style>
  <Style Selector="Border.tag.muted > TextBlock"><Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" /></Style>
  <Style Selector="Border.tag.mono > TextBlock"><Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" /></Style>

  <!-- ══ 状态圆点 7×7 ══════════════════════════════════════════════════════════ -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource VelaTextMuted}" />
  </Style>
  <Style Selector="Ellipse.dot.ok"><Setter Property="Fill" Value="{DynamicResource VelaStatusConnected}" /></Style>
  <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{DynamicResource VelaWarning}" /></Style>
  <Style Selector="Ellipse.dot.err"><Setter Property="Fill" Value="{DynamicResource VelaError}" /></Style>
  <Style Selector="Ellipse.dot.info"><Setter Property="Fill" Value="{DynamicResource VelaInfo}" /></Style>
  <Style Selector="Ellipse.dot.accent"><Setter Property="Fill" Value="{DynamicResource VelaAccent}" /></Style>
  <Style Selector="Ellipse.dot.connecting"><Setter Property="Fill" Value="{DynamicResource VelaStatusConnecting}" /></Style>
  <Style Selector="Ellipse.dot.off"><Setter Property="Fill" Value="{DynamicResource VelaTextMuted}" /></Style>

  <!-- ══ 分隔线、卡片、面板头 ═════════════════════════════════════════════════════ -->
  <Style Selector="Rectangle.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Fill" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.input">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Border.segments">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Height" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toolrow">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.colheader">
    <Setter Property="Height" Value="26" />
    <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Height" Value="28" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{ui:Dim VelaInfo, 0.1}" />
    <Setter Property="BorderBrush" Value="{ui:Dim VelaInfo, 0.35}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.notice.warn">
    <Setter Property="Background" Value="{ui:Dim VelaWarning, 0.12}" />
    <Setter Property="BorderBrush" Value="{ui:Dim VelaWarning, 0.4}" />
  </Style>
  <Style Selector="Border.notice.err">
    <Setter Property="Background" Value="{ui:Dim VelaError, 0.12}" />
    <Setter Property="BorderBrush" Value="{ui:Dim VelaError, 0.4}" />
  </Style>
  <Style Selector="Border.notice.ok">
    <Setter Property="Background" Value="{ui:Dim VelaStatusConnected, 0.1}" />
    <Setter Property="BorderBrush" Value="{ui:Dim VelaStatusConnected, 0.35}" />
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.code TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <!-- ══ 对话框:8px 圆角、VelaBgPage 底、VelaBorderSecondary 描边、VelaShadowWindow 阴影 ══ -->
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource VelaBgPage}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource VelaShadowWindow}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.dialog-titlebar">
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0,0,0" />
  </Style>
  <Style Selector="Border.dialog-footer">
    <Setter Property="Height" Value="48" />
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="Button.dialog-close">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="27" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.dialog-close:pointerover /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource VelaError}" />
  </Style>

  <!-- ══ 行列表(ListBox):悬停 VelaBgHover、选中 VelaBgActive,与宿主资源管理器同一对令牌 ══ -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
  </Style>

  <!-- ══ 进度条(细条:Accent 填充 + VelaBgActive 轨) ══ -->
  <Style Selector="ProgressBar.thin">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
  </Style>

  <!-- ══ 下拉(紧凑) ══ -->
  <Style Selector="ComboBox.compact">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
