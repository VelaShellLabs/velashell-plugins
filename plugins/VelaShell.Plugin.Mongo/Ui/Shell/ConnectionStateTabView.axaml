<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:VelaShell.Plugin.Mongo.Ui"
             x:Class="VelaShell.Plugin.Mongo.Ui.ConnectionStateTabView"
             x:DataType="ui:ConnectionStateTabViewModel"
             Background="{DynamicResource VelaBgTerminal}">

  <!-- 设计稿 22「连接状态」:占位标签里居中一张卡片,不弹模态框。
       连接中 · 卡片宽 340:转圈 + 「正在连接 X」+ 经哪个跳板 + 取消。
       连接失败 · 卡片宽 560:红色叉 + 「无法连接 X」+ 连的哪儿 + 等宽字的原因 + 编辑连接 / 关闭标签页 / 重新连接。 -->
  <Panel>
    <Border Classes="card" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22"
            IsVisible="{Binding IsConnecting}">
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center"
                Background="{ui:Dim VelaAccent, 0.16}">
          <ui:CollectionSpinner Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Classes="ui primary semibold" HorizontalAlignment="Center" TextAlignment="Center"
                   FontSize="{DynamicResource VelaFontSize14}" Text="{Binding ConnectingTitle}" />
        <TextBlock Classes="ui small tertiary wrap" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding Detail}" />
        <Button x:Name="CancelButton" Theme="{StaticResource MongoOutlineButton}" Height="26" Padding="14,0" Margin="0,4,0,0"
                HorizontalAlignment="Center" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>

    <Border Classes="card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,18"
            IsVisible="{Binding IsFailed}">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Background="{ui:Dim VelaError, 0.14}">
            <ui:Glyph Key="Mongo.circle-x" Size="16" Brush="{DynamicResource VelaError}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
            <TextBlock Classes="ui primary semibold" FontSize="{DynamicResource VelaFontSize14}" Text="{Binding FailedTitle}" />
            <TextBlock Classes="ui small tertiary trim" Text="{Binding Detail}" />
          </StackPanel>
        </Grid>
        <Border Classes="code" Padding="10,8">
          <SelectableTextBlock TextWrapping="Wrap" Foreground="{DynamicResource VelaTextSecondary}" LineHeight="18"
                               FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize11}"
                               Text="{Binding ErrorMessage}" />
        </Border>
        <StackPanel Spacing="6" IsVisible="{Binding CanTrust}">
          <TextBlock Classes="ui small tertiary" Text="{Binding Loc[Conn_CertTitle]}" />
          <TextBlock Classes="mono small secondary wrap" Text="{Binding CertificateText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Theme="{StaticResource MongoOutlineButton}" Height="28" Padding="12,0" Command="{Binding EditCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Mongo.pencil" Size="12" Brush="{DynamicResource VelaTextSecondary}" />
              <TextBlock Classes="ui small" Text="{Binding Loc[Conn_Edit]}" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource MongoOutlineButton}" Height="28" Padding="12,0" Command="{Binding CloseCommand}">
            <TextBlock Classes="ui small" Text="{Binding Loc[Conn_CloseTab]}" />
          </Button>
          <Button Theme="{StaticResource MongoOutlineButton}" Height="28" Padding="12,0" Command="{Binding TrustCommand}"
                  IsVisible="{Binding CanTrust}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Mongo.shield" Size="12" Brush="{DynamicResource VelaWarning}" />
              <TextBlock Classes="ui small" Text="{Binding Loc[Conn_TrustReconnect]}" />
            </StackPanel>
          </Button>
          <Button x:Name="ReconnectButton" Theme="{StaticResource MongoPillButton}" Height="28" Padding="12,0"
                  Command="{Binding ReconnectCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Mongo.refresh-cw" Size="12" Brush="{DynamicResource VelaAccent}" />
              <TextBlock Classes="ui small" Text="{Binding Loc[Conn_Reconnect]}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
