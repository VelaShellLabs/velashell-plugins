<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:VelaShell.Plugin.Mongo.Ui"
             x:Class="VelaShell.Plugin.Mongo.Ui.RevealPasswordDialogView"
             x:DataType="ui:RevealPasswordDialogViewModel">

  <!-- 新密码只显示这一次:等宽大字 + 复制;说明写清关掉就再也看不到。 -->
  <UserControl.Styles>
    <StyleInclude Source="avares://VelaShell.Plugin.Mongo/Ui/MongoStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="*,48">
    <StackPanel Grid.Row="0" Margin="16,14,16,14" Spacing="10">
      <Border Classes="notice ok" Padding="10,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Glyph Key="Mongo.circle-check" Size="13" Brush="{DynamicResource VelaStatusConnected}" />
          <TextBlock Classes="ui ok" Text="{Binding Loc[Users_RevealCopied]}" />
        </StackPanel>
      </Border>
      <Border Classes="code" Padding="12,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Theme="{StaticResource MongoIconButton}" Command="{Binding CopyCommand}"
                  ToolTip.Tip="{Binding Loc[Common_Copy]}">
            <ui:Glyph Key="Mongo.copy" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
          </Button>
          <SelectableTextBlock FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize14}"
                               Foreground="{DynamicResource VelaTextPrimary}" VerticalAlignment="Center"
                               Text="{Binding Password}" />
        </DockPanel>
      </Border>
      <TextBlock Classes="ui small tertiary wrap" Text="{Binding Loc[Users_RevealHint]}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="dialog-footer">
      <Button Theme="{StaticResource MongoPillButton}" HorizontalAlignment="Right" Content="{Binding Loc[Users_RevealDone]}"
              Command="{Binding CloseCommand}" />
    </Border>
  </Grid>
</UserControl>
