<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:VelaShell.Plugin.Mongo.Ui"
             x:Class="VelaShell.Plugin.Mongo.Ui.ResetPasswordDialogView"
             x:DataType="ui:ResetPasswordDialogViewModel">

  <!-- 重置密码:新密码 + 确认 + 生成。外壳画 28px 标题栏,这里只画内容与 48px 底栏。 -->
  <UserControl.Styles>
    <StyleInclude Source="avares://VelaShell.Plugin.Mongo/Ui/MongoStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="*,48">
    <StackPanel Grid.Row="0" Margin="16,14,16,14" Spacing="10">
      <StackPanel Spacing="5">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Theme="{StaticResource MongoToolButton}" Height="20" Padding="5,0" Command="{Binding GenerateCommand}"
                    ToolTip.Tip="{Binding Loc[Users_GenerateTip]}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ui:Glyph Key="Mongo.wand-sparkles" Size="11" Brush="{DynamicResource VelaAccent}" />
                <TextBlock Classes="ui small accent" Text="{Binding Loc[Users_Generate]}" />
              </StackPanel>
            </Button>
            <ToggleButton Theme="{StaticResource MongoSwitch}" IsChecked="{Binding Reveal}" Margin="6,0,0,0"
                          ToolTip.Tip="{Binding Loc[Users_RevealPassword]}" />
          </StackPanel>
          <TextBlock Classes="mono small secondary" Text="{Binding Loc[Users_NewPassword]}" />
        </DockPanel>
        <TextBox x:Name="PasswordBox" Theme="{StaticResource MongoTextBox}" Height="28" Text="{Binding Password}"
                 PasswordChar="{Binding PasswordChar}" />
      </StackPanel>
      <StackPanel Spacing="5">
        <TextBlock Classes="mono small secondary" Text="{Binding Loc[Users_ConfirmPassword]}" />
        <TextBox Theme="{StaticResource MongoTextBox}" Height="28" Text="{Binding Confirm}" PasswordChar="{Binding PasswordChar}"
                 Classes.invalid="{Binding Mismatch}" />
      </StackPanel>
      <TextBlock Classes="ui small err" Text="{Binding Loc[Users_PasswordMismatch]}" IsVisible="{Binding Mismatch}" />
      <TextBlock Classes="ui small warn" Text="{Binding Loc[Users_PasswordWeak]}" IsVisible="{Binding Weak}" />
      <TextBlock Classes="ui small tertiary wrap" Text="{Binding Loc[Users_ResetHint]}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Theme="{StaticResource MongoOutlineButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CloseCommand}" />
        <Button Theme="{StaticResource MongoPillButton}" Command="{Binding ApplyCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ui:Glyph Key="Mongo.check" Size="12" Brush="{DynamicResource VelaAccent}" />
            <TextBlock Text="{Binding Loc[Users_ResetApply]}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
