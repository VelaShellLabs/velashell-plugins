<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:VelaShell.Plugin.Mongo.Ui"
             x:Class="VelaShell.Plugin.Mongo.Ui.PipelineStagePickerView"
             x:DataType="ui:PipelineStagePickerViewModel">

  <!-- 阶段搜索弹层:顶部搜索框,下面是阶段列表(名字洋红等宽 + 短说明),右侧一句完整说明。
       与补全弹层(设计稿 03)同一套外框:VelaBgSurface 底、VelaBorderSecondary 描边、6px 圆角、窗口阴影。 -->
  <UserControl.Styles>
    <StyleInclude Source="avares://VelaShell.Plugin.Mongo/Ui/MongoStyles.axaml" />
  </UserControl.Styles>

  <Border Width="420" Background="{DynamicResource VelaBgSurface}" BorderBrush="{DynamicResource VelaBorderSecondary}"
          BorderThickness="1" CornerRadius="6" BoxShadow="{DynamicResource VelaShadowWindow}" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <Border Grid.Row="0" Padding="8" BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
        <Panel>
          <TextBox x:Name="Search" Theme="{StaticResource MongoTextBox}" Height="26" Padding="26,0,8,0"
                   Text="{Binding Query}" PlaceholderText="{Binding Loc[Pipe_SearchStages]}" />
          <ui:Glyph Key="Mongo.search" Size="12" Margin="9,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Brush="{DynamicResource VelaTextMuted}" />
        </Panel>
      </Border>
      <ListBox x:Name="List" Grid.Row="1" Classes="rows" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
               MaxHeight="300" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="3" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ui:PipelineStageChoice">
            <Grid ColumnDefinitions="Auto,120,*" Height="26" Margin="6,0" Background="Transparent">
              <ui:Glyph Grid.Column="0" Key="Mongo.layers" Size="12" Margin="0,0,8,0" Brush="{DynamicResource VelaAccent}" />
              <TextBlock Grid.Column="1" Classes="mono medium trim" Foreground="{DynamicResource VelaShellMagenta}" Text="{Binding Name}" />
              <TextBlock Grid.Column="2" Classes="ui small tertiary trim" Text="{Binding Short}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="2" Padding="10,7" Background="{DynamicResource VelaBgSidebar}"
              BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,1,0,0"
              IsVisible="{Binding Selected, Converter={x:Static ui:Converters.NotEmpty}}">
        <TextBlock Classes="ui small secondary wrap" Text="{Binding Selected.Description}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
