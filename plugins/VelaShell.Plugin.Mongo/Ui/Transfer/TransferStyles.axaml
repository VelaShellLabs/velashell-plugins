<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:VelaShell.Plugin.Mongo.Ui">

  <!--
    导出 / 导入 / 数据传输三个向导共用的版式(设计稿 19 / 20 / 21)。
    只放这三块独有的东西:左栏步骤、格式卡片、实心勾选框、右栏分节;
    通用的按钮、文字、行、标签一律用 MongoStyles.axaml 里的那一套。
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <!-- ══ 左栏的一步:圆角 4、内边距 8;当前步 VelaBgActive 底;已完成的可点回去(悬停 VelaBgHover) ══ -->
      <ControlTheme x:Key="XferStepButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.current /template/ Border#Bg">
          <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
        </Style>
        <Style Selector="^:pointerover:not(:disabled) /template/ Border#Bg">
          <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
        </Style>
        <Style Selector="^.current:pointerover /template/ Border#Bg">
          <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
        </Style>
        <Style Selector="^:not(:disabled)">
          <Setter Property="Cursor" Value="Hand" />
        </Style>
      </ControlTheme>

      <!-- ══ 格式卡片(RadioButton):选中 = AccentDim 底 + Accent 描边 ══ -->
      <ControlTheme x:Key="XferFormatCard" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Card">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Card">
          <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
      </ControlTheme>

      <!-- ══ 实心勾选框(设计稿 19 / 20:13px,勾上 = Accent 实心底 + AccentForeground 勾) ══ -->
      <ControlTheme x:Key="XferCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
              <Border Name="Box" Width="13" Height="13" CornerRadius="2" BorderThickness="1"
                      BorderBrush="{DynamicResource VelaBorderSecondary}" Background="Transparent" VerticalAlignment="Center">
                <ui:Glyph Name="Tick" Key="Mongo.check" Size="9" Brush="{DynamicResource VelaAccentForeground}" IsVisible="False" />
              </Border>
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Box">
          <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:checked /template/ ui|Glyph#Tick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Box">
          <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ══ 左栏:200px、VelaBgSidebar、右描边 ══ -->
  <Style Selector="Border.xfer-steps">
    <Setter Property="Width" Value="200" />
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="10,14" />
  </Style>

  <!-- 步骤圆:20×20。已完成 = 绿淡底 + 绿勾;当前 = Accent 实心 + AccentForeground 数字;未到 = 灰圈 -->
  <Style Selector="Border.xnum">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.xnum.done">
    <Setter Property="Background" Value="{ui:Dim VelaStatusConnected, 0.1}" />
  </Style>
  <Style Selector="Border.xnum.current">
    <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="Border.xnum.pending">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.xnum > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
  </Style>
  <Style Selector="Border.xnum.current > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VelaAccentForeground}" />
  </Style>
  <Style Selector="TextBlock.xstep-title">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
  </Style>
  <Style Selector="TextBlock.xstep-title.current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.xstep-title.pending">
    <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
  </Style>

  <!-- ══ 右栏:300px、VelaBgSidebar、左描边;每节下描边、内边距 [12,14] ══ -->
  <Style Selector="Border.xfer-side">
    <Setter Property="Width" Value="300" />
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.xsec">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- ══ 主区的卡片(来源条、文件条、端点卡):VelaBgSidebar + 1px 描边 + 圆角 4 ══ -->
  <Style Selector="Border.xcard">
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- ══ 表格外框:VelaBgTerminal + 1px 描边 + 圆角 4 ══ -->
  <Style Selector="Border.xtable">
    <Setter Property="Background" Value="{DynamicResource VelaBgTerminal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.xtable Border.colheader">
    <Setter Property="CornerRadius" Value="3,3,0,0" />
  </Style>

  <!-- 行底色:警告橙淡底、错误红淡底、当前 VelaBgHover -->
  <Style Selector="Border.xrow-warn">
    <Setter Property="Background" Value="{ui:Dim VelaWarning, 0.12}" />
  </Style>
  <Style Selector="Border.xrow-err">
    <Setter Property="Background" Value="{ui:Dim VelaError, 0.12}" />
  </Style>
  <Style Selector="Border.xrow-active">
    <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
  </Style>

  <!-- ══ 下拉:设计稿的 Sel 是界面字体 10px(不是等宽) ══ -->
  <Style Selector="ComboBox.xsel">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <!-- 表格里的下拉(字段表的「转换」):平时只是一行字 + 小箭头,不抢眼;悬停才显出外框 -->
  <Style Selector="ComboBox.xflat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="0,0,4,0" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
  </Style>
  <Style Selector="ComboBox.xsel-mono">
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
  </Style>

  <!-- 22px 的表内输入框(CSV 列名) -->
  <Style Selector="TextBox.xcell">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
  </Style>

  <!-- 粗一点的总进度条(设计稿 21:6px,VelaBorderPrimary 轨) -->
  <Style Selector="ProgressBar.xbar">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="ProgressBar.xmini">
    <Setter Property="Width" Value="80" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ProgressBar.xmini.ok">
    <Setter Property="Foreground" Value="{DynamicResource VelaStatusConnected}" />
  </Style>
</Styles>
