<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:VelaShell.Plugin.Mongo.Ui"
             x:Class="VelaShell.Plugin.Mongo.Ui.GridFsRenameDialogView"
             x:DataType="ui:GridFsRenameDialogViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://VelaShell.Plugin.Mongo/Ui/MongoStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="*,48">
    <StackPanel Grid.Row="0" Margin="16,14" Spacing="8">
      <TextBlock Classes="ui small secondary" Text="{Binding Loc[Fs_RenameLabel]}" />
      <TextBox x:Name="NameBox" Theme="{StaticResource MongoTextBox}" Height="28" Text="{Binding Name}"
               Classes.invalid="{Binding HasError}" />
      <TextBlock Classes="ui small err wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ui:Glyph Key="Mongo.info" Size="12" Brush="{DynamicResource VelaInfo}" />
        <TextBlock Classes="ui small tertiary wrap" Text="{Binding Hint}" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Theme="{StaticResource MongoOutlineButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CloseCommand}" />
        <Button Theme="{StaticResource MongoPillButton}" Content="{Binding Loc[Fs_Rename]}" Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
