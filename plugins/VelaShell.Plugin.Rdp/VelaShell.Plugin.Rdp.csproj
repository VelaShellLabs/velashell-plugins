<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Pure-managed RDP remote desktop workspace.</Description>
    <VelaPluginId>velashell.rdp</VelaPluginId>
    <!-- The [LibraryImport] source generator (UnixClipboardFile libc interop) emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VelaShell.PluginSdk.Build" />
    <InternalsVisibleTo Include="VelaShell.Plugin.Rdp.Tests" />
  </ItemGroup>
</Project>
