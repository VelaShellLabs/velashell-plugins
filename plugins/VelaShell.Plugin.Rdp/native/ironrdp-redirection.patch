+    /// Initial Windows logical-volume mappings, copied when attached to a connector.
+    /// Only full drive-letter roots such as `C:\\` are supported; folders and UNC paths are rejected.
+    #[diplomat::opaque]
+    pub struct WindowsRdpdrConfig {
+        pub drives: Vec<(u32, String, String, bool)>,
+    }
+
+    impl WindowsRdpdrConfig {
+        pub fn new() -> Box<WindowsRdpdrConfig> {
+            Box::new(Self { drives: Vec::new() })
+        }
+
+        /// Adds an initial mapping. This does not expose dynamic hotplug.
+        pub fn add_drive(
+            &mut self,
+            device_id: u32,
+            display_name: &str,
+            root_path: &str,
+            read_only: bool,
+        ) -> Result<(), Box<IronRdpError>> {
+            if device_id == 0 || self.drives.iter().any(|(id, _, _, _)| *id == device_id) {
+                return Err("drive device ID must be unique and nonzero".into());
+            }
+            if display_name.is_empty() || display_name.contains('\0') {
+                return Err("drive display name must be nonempty and contain no NUL".into());
+            }
+            let root = root_path.as_bytes();
+            if root.len() != 3 || !root[0].is_ascii_alphabetic() || root[1] != b':' || root[2] != b'\\' {
+                return Err("drive root must be a full Windows logical-volume root such as C:\\".into());
+            }
+            self.drives.push((device_id, display_name.to_owned(), root_path.to_owned(), read_only));
+            Ok(())
+        }
+    }
