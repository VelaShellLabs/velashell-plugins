+#[test]
+fn oversized_declared_channel_length_is_rejected_before_retaining_fragments() {
+    let mut channel = StaticVirtualChannel::new(RuntimeChannel::new("cliprdr", ChannelOptions::empty()));
+    let oversized = channel_chunk(&[0], 16 * 1024 * 1024 + 1, ChannelControlFlags::FLAG_FIRST);
+    assert!(channel.process(&oversized).is_err());
+    let valid = channel_chunk(&[1], 1, ChannelControlFlags::FLAG_FIRST | ChannelControlFlags::FLAG_LAST);
+    assert!(channel.process(&valid).is_ok());
+}
