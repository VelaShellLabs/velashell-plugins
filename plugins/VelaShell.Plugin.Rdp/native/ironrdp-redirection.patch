+        /// Attaches an immutable initial Windows filesystem mapping before connection negotiation.
+        /// Do not also attach the legacy no-op RDPDR channel to this connector.
+        pub fn with_static_channel_windows_rdpdr(
+            &mut self,
+            computer_name: &str,
+            config: &WindowsRdpdrConfig,
+        ) -> Result<(), Box<IronRdpError>> {
+            let Some(connector) = self.0.as_mut() else {
+                return Err(ValueConsumedError::for_item("connector").into());
+            };
+            if !matches!(connector.state, ironrdp::connector::ClientConnectorState::ConnectionInitiationSendRequest) {
+                return Err("initial drive mappings must be attached before connection negotiation".into());
+            }
+            if config.drives.is_empty() {
+                return Err("initial drive mappings must not be empty".into());
+            }
+            if connector.get_static_channel_processor_mut::<ironrdp::rdpdr::Rdpdr>().is_some() {
+                return Err("an RDPDR channel is already attached".into());
+            }
+            let rdpdr = super::build_windows_rdpdr(config, computer_name)?;
+            connector.attach_static_channel(rdpdr);
+            Ok(())
+        }
