+#[cfg(windows)]
+fn build_windows_rdpdr(
+    config: &ffi::WindowsRdpdrConfig,
+    computer_name: &str,
+) -> Result<ironrdp::rdpdr::Rdpdr, Box<crate::error::ffi::IronRdpError>> {
+    use ironrdp_rdpdr_native::{RedirectedDrive, WindowsRdpdrBackendFactory};
+
+    let drives = config
+        .drives
+        .iter()
+        .map(|(device_id, name, root, read_only)| RedirectedDrive::new(*device_id, name.clone(), root, *read_only))
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|error| crate::error::GenericError(anyhow::anyhow!(error)))?;
+    let factory = WindowsRdpdrBackendFactory::from_drives(drives)
+        .map_err(|error| crate::error::GenericError(anyhow::anyhow!(error)))?;
+    Ok(ironrdp::rdpdr::Rdpdr::new(Box::new(factory.build()), computer_name.to_owned())
+        .with_drives(Some(factory.initial_drives())))
+}
+
+#[cfg(not(windows))]
+fn build_windows_rdpdr(
+    _config: &ffi::WindowsRdpdrConfig,
