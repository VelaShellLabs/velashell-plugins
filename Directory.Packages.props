<Project>
  <!--
    中央包版本管理(CPM)。本仓库所有工程的 NuGet 版本号只在这一处出现 ——
    五个插件 + 五个测试工程,谁也不许在 csproj 里写 Version=。

    为什么值得:插件之间会共用同一个包(AWSSDK.S3 在 S3 插件与它的测试里各一份、
    Avalonia 在测试工程里五处),版本散在各 csproj 时"改了一处忘了另一处"没有任何
    东西会报错 —— 直到运行期才以类型加载失败的形式冒出来。集中之后这类漂移在语法上
    就不可能发生。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 传递依赖被直接引用时报错,免得哪天某个包不再传递它就悄悄断了。 -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="VelaShell 插件 SDK(源码在 VelaShellLabs/velashell-plugin-sdk 与 velashell-plugin-cli)">
    <!-- 插件工程只需要这一个包:契约程序集、与宿主版本一致的 Avalonia(含 AXAML 编译器)、
         plugin.json 处理、清单编译期校验与 `dotnet build -t:PackVpx` 都随它到位。
         所以下面**没有** Avalonia 的条目给插件用 —— 插件不该自己声明 Avalonia。 -->
    <PackageVersion Include="VelaShell.PluginSdk.Build" Version="1.5.1" />
    <!-- 测试替身:TestPluginContext 与各能力的内存实现,不起宿主即可测插件逻辑。 -->
    <PackageVersion Include="VelaShell.PluginSdk.Testing" Version="1.5.0" />
  </ItemGroup>
  <ItemGroup Label="Avalonia(仅测试工程用:测试宿主扮演装载方,要提供运行时那份)">
    <!-- ⚠️ 必须与 VelaShell.PluginSdk.Build 锁给插件工程的那一版**完全相同** ——
         Directory.Build.targets 的 VerifyAvaloniaMatchesSdk 在构建期拿 SDK 包导出的
         权威值核对这里(VELAP1000),漂了就红。升 SDK 之后按它的报错把这三行跟上。
         插件工程**不该**出现在这里:Avalonia 由 VelaShell.PluginSdk.Build 用精确区间锁给它们。 -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <!-- 菜单等控件的模板由主题提供:没有它 MenuItem 无模板、不可命中,真实点击测不了。 -->
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup Label="Redis 插件">
    <!-- MIT,与本仓库 AGPL-3.0 + 商业双许可相容。随插件目录分发。 -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>
  <ItemGroup Label="S3 插件">
    <!-- Apache-2.0,与本仓库 AGPL-3.0 + 商业双许可相容。随插件目录分发。
         测试工程也要引它(环回服务器要按收到的原始请求行重算 SigV4),
         集中管版本正是为了这两处永远一致。 -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.4" />
  </ItemGroup>
  <ItemGroup Label="串口插件">
    <!-- MIT,微软自家维护,Windows / Linux / macOS 的 RID 原生包齐全。
         选型取证见 velashell-docs 的 zh/host/Telnet与串口可行性调研.md §4.1
         (备选 RJCP.SerialPortStream 是 MS-PL 弱 copyleft,与本仓库的商业授权要另行合规;
          SerialPort.Net 2021 年即停维护)。
         注意:这个包带 runtimes/<rid>/native/,插件目录里必须**有那一层** ——
         没有的话 Linux/macOS 上是运行期 PlatformNotSupportedException,
         而在 Windows 开发机上永远测不出来(调研文档 §五.2 记的正是这条)。 -->
    <PackageVersion Include="System.IO.Ports" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>
  <ItemGroup Label="测试框架">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>