<Project>
  <!--
    中央包版本管理(CPM)。本仓库所有工程的 NuGet 版本号只在这一处出现 ——
    插件、测试工程与 src/ 下的库,谁也不许在 csproj 里写 Version=。

    为什么值得:插件之间会共用同一个包(AWSSDK.S3 在 S3 插件与它的测试里各一份、
    Avalonia 在测试工程里五处),版本散在各 csproj 时"改了一处忘了另一处"没有任何
    东西会报错 —— 直到运行期才以类型加载失败的形式冒出来。集中之后这类漂移在语法上
    就不可能发生。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 传递依赖被直接引用时报错,免得哪天某个包不再传递它就悄悄断了。 -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="VelaShell 插件 SDK(源码在 VelaShell/velashell-plugin-sdk,.Build 与 .Testing 同版本、同一次发布)">
    <!-- 插件工程需要这个包提供契约程序集、plugin.json 处理、清单编译期校验与
         `dotnet build -t:PackVpx`;UI 插件的 Avalonia/AXAML 编译资产由下方目标宿主条目拥有。 -->
    <PackageVersion Include="VelaShell.PluginSdk.Build" Version="2.2.1" />
    <!-- 测试替身:TestPluginContext 与各能力的内存实现,不起宿主即可测插件逻辑。 -->
    <PackageVersion Include="VelaShell.PluginSdk.Testing" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup Label="Avalonia target-host compile/test assets">
    <!-- These are the target host's shared versions. UI plugins reference the compile
         assets directly with runtime excluded; test projects supply the runtime assets. -->
    <PackageVersion Include="Avalonia" Version="$(VelaAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(VelaAvaloniaVersion)" />
    <!-- 菜单等控件的模板由主题提供:没有它 MenuItem 无模板、不可命中,真实点击测不了。 -->
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(VelaAvaloniaVersion)" />
    <!-- 真渲染(Skia)的 headless 截图:MongoDB 插件的界面回归要拿像素和设计稿比,
         UseHeadlessDrawing 那条假绘制路径给不出位图。同样只服务于测试工程,版本随上面三个一起走。 -->
    <PackageVersion Include="Avalonia.Skia" Version="$(VelaAvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup Label="Docker 面板与 MongoDB 插件">
    <!-- MIT. AvaloniaEdit is compile-only because the host supplies the shared assembly.
         Its target-host version is declared by VelaAvaloniaEditVersion and checked against
         the resolved references during the build. Test projects provide the runtime copy. -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="$(VelaAvaloniaEditVersion)" />
  </ItemGroup>
  <ItemGroup Label="Redis 插件">
    <!-- MIT,与本仓库 AGPL-3.0 + 商业双许可相容。随插件目录分发。 -->
    <PackageVersion Include="StackExchange.Redis" Version="4.0.165-alpha" />
  </ItemGroup>
  <ItemGroup Label="MongoDB 插件">
    <!-- Apache-2.0,与本仓库 AGPL-3.0 + 商业双许可相容。随插件目录分发(连同它带的
         MongoDB.Bson / DnsClient / SharpCompress / Snappier / ZstdSharp)。
         测试工程也引它:种数据与清理走同一个驱动,版本集中管才不会两边各说各话。 -->
    <PackageVersion Include="MongoDB.Driver" Version="3.14.1" />
  </ItemGroup>
  <ItemGroup Label="S3 插件">
    <!-- Apache-2.0,与本仓库 AGPL-3.0 + 商业双许可相容。随插件目录分发。
         测试工程也要引它(环回服务器要按收到的原始请求行重算 SigV4),
         集中管版本正是为了这两处永远一致。 -->
    <PackageVersion Include="AWSSDK.S3" Version="4.1.2" />
  </ItemGroup>
  <ItemGroup Label="串口插件">
    <!-- MIT,微软自家维护,Windows / Linux / macOS 的 RID 原生包齐全。
         选型取证见 velashell-docs 的 zh/host/Telnet与串口可行性调研.md §4.1
         (备选 RJCP.SerialPortStream 是 MS-PL 弱 copyleft,与本仓库的商业授权要另行合规;
          SerialPort.Net 2021 年即停维护)。
         注意:这个包带 runtimes/<rid>/native/,插件目录里必须**有那一层** ——
         没有的话 Linux/macOS 上是运行期 PlatformNotSupportedException,
         而在 Windows 开发机上永远测不出来(调研文档 §五.2 记的正是这条)。 -->
    <PackageVersion Include="System.IO.Ports" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="RDP 托管图形解码">
    <PackageVersion Include="ManagedCodecs.H264" Version="0.19.0" />
  </ItemGroup>
  <ItemGroup Label="RDP 托管 DTLS">
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.8.0-beta.349" />
  </ItemGroup>
  <ItemGroup Label="测试框架">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>