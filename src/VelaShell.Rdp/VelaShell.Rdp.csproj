<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VelaShell.Rdp — 纯托管 .NET RDP(远程桌面协议)客户端库。
    从 VelaShell.Plugin.Rdp 抽出的协议栈 + 会话 + 契约,UI 无关,音频调用系统库,
    也不依赖 VelaShell.PluginSdk。插件引用本库并提供 Avalonia 界面。
    不单独出 NuGet 包(随仓库沿用 IsPackable=false),DLL 随插件 .vpx 一起分发。
  -->
  <PropertyGroup>
    <RootNamespace>VelaShell.Rdp</RootNamespace>
    <AssemblyName>VelaShell.Rdp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Managed .NET RDP (Remote Desktop Protocol) client: X.224/MCS/GCC, TLS and CredSSP/NLA, interleaved RLE, MPPC and managed RDPGFX with H.264 AVC420/AVC444 decoding, fast-path input, clipboard and drive virtual channels, dynamic resolution (MS-RDPEDISP), and audio playback (MS-RDPEA) through system audio libraries. No bundled native binaries.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- 公共 API 的 XML 文档尚未补齐,先消掉缺文档告警(CS1591)。 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VelaShell.Plugin.Rdp.Tests" />
    <InternalsVisibleTo Include="VelaShell.Plugin.Rdp" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="ManagedCodecs.H264" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" TargetPath="VelaShell.Rdp.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

</Project>
