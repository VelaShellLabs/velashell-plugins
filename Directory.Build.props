<Project>
  <PropertyGroup>
	<TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <!-- 定义 Linux -->
  <PropertyGroup>
  	<IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLinux)' == 'true'">
  	<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- ── 本仓库的发行版本号 ─────────────────────────────────────────────────
         本仓库所有插件程序集共用它。CI 发版时用 -p:VelaPluginsVersion= 覆盖(取自 Release 标签)。

         ⚠️ 它**不是** SDK 版本(那个在 Directory.Packages.props 的 PackageVersion 上,
         本文件里没有 VelaSdkVersion),也**不是**单个插件的版本 ——
         后者写在各插件的 plugin.json 里,决定 .vpx 文件名与宿主看到的插件版本,
         各插件各自演进,互不牵连。这里这个号只回答"这一批插件是哪次发布出去的"。 -->
    <VelaPluginsVersion Condition="'$(VelaPluginsVersion)' == ''">1.5.0</VelaPluginsVersion>
    <!-- 去掉预发布后缀的数字版(AssemblyVersion/FileVersion 不接受后缀)。 -->
    <VelaPluginsVersionCore>$([System.Text.RegularExpressions.Regex]::Replace($(VelaPluginsVersion), '-.*$', ''))</VelaPluginsVersionCore>
    <Version>$(VelaPluginsVersion)</Version>
    <AssemblyVersion>$(VelaPluginsVersionCore)</AssemblyVersion>
    <FileVersion>$(VelaPluginsVersionCore)</FileVersion>
    <!-- 不把 git 提交哈希拼进 InformationalVersion(默认会加 +sha 后缀)。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    ⚠️ NuGet 依赖的版本号**一律不在这里定义**。本仓库启用了 CPM,全部写在
    Directory.Packages.props 的 PackageVersion 上,用 VS 的 NuGet 包管理器直接升即可。

    两条相关纪律:
      · 插件工程只引 VelaShell.PluginSdk.Build 一个包(契约 + 与宿主一致的 Avalonia +
        AXAML 编译器 + plugin.json 处理 + 清单校验 + -t:PackVpx 全随它到位),
        本仓库的第一方插件与第三方插件走**完全同一条路径**;
      · Avalonia 只出现在**测试工程**(测试宿主扮演装载方,得提供运行时那份),
        版本必须与 SDK 锁的一致 —— Directory.Build.targets 的 VerifyAvaloniaMatchesSdk
        在构建期核对(VELAP1000)。

    本地联调一版还没发布的 SDK:见 nuget.config 里那条注释掉的本地源。
  -->

  <PropertyGroup>
  	<Authors>joesdu</Authors>
  	<RepositoryType>git</RepositoryType>
  	<RepositoryUrl>https://github.com/VelaShellLabs/velashell-plugins</RepositoryUrl>
  	<GenerateAssemblyConfigurationAttribute>True</GenerateAssemblyConfigurationAttribute>
  	<GenerateAssemblyCompanyAttribute>True</GenerateAssemblyCompanyAttribute>
  	<GenerateAssemblyProductAttribute>True</GenerateAssemblyProductAttribute>
  	<GenerateDocumentationFile>True</GenerateDocumentationFile>
  	<!-- 本仓库不出 NuGet 包:插件的分发形态是 .vpx 与随应用分发的 plugins/ 目录。 -->
  	<IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
  	<EnablePreviewFeatures>true</EnablePreviewFeatures>
  	<Features>$(Features);runtime-async=on</Features>
  	<NoWarn>$(NoWarn);CA2252;SYSLIB5007;</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
  	<LangVersion>preview</LangVersion>
  	<Nullable>enable</Nullable>
  	<ImplicitUsings>enable</ImplicitUsings>
  	<NoWarn>$(NoWarn);IDE0047;</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <VelaRepoRoot>$(MSBuildThisFileDirectory)</VelaRepoRoot>
    <VelaArtifactsDir Condition="'$(VelaArtifactsDir)' == ''">$(VelaRepoRoot)artifacts</VelaArtifactsDir>
  </PropertyGroup>
</Project>
