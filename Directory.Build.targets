<Project>
	<!-- 自定义任务来检查 TargetFramework 和 TargetFrameworks -->
	<Target Name="CheckTargetFramework" BeforeTargets="BeforeBuild" Condition="'$(UseWPF)' != 'true' and '$(UseWindowsForms)' != 'true' and '$(IsRoslynComponent)' != 'true'">
		<XmlPeek XmlInputPath="$(MSBuildProjectFullPath)" Query="//*[local-name()='TargetFramework' or local-name()='TargetFrameworks']">
			<Output TaskParameter="Result" ItemName="ExplicitTargetFramework" />
		</XmlPeek>
		<Error Condition="'@(ExplicitTargetFramework)' != ''" File="$(MSBuildProjectFullPath)" Text="在启用按文件夹自定义生成的情况下,已指定目标框架.项目文件中不应显式定义 TargetFramework 或 TargetFrameworks 属性,请删除." />
	</Target>

	<!--
	  Target-host alignment. Avalonia ownership lives with the host release, not the SDK.
	  Test projects use these central package versions as their runtime host; UI plugins
	  provide compile-only references and the SDK/this check validates resolved assets.
	-->
	<Target Name="VerifyTargetHostAvaloniaPackages" BeforeTargets="BeforeBuild">
		<PropertyGroup>
			<_VelaAvaloniaPin>@(PackageVersion->WithMetadataValue('Identity','Avalonia')->'%(Version)')</_VelaAvaloniaPin>
			<_VelaAvaloniaHeadlessPin>@(PackageVersion->WithMetadataValue('Identity','Avalonia.Headless')->'%(Version)')</_VelaAvaloniaHeadlessPin>
			<_VelaAvaloniaThemesPin>@(PackageVersion->WithMetadataValue('Identity','Avalonia.Themes.Fluent')->'%(Version)')</_VelaAvaloniaThemesPin>
			<_VelaAvaloniaSkiaPin>@(PackageVersion->WithMetadataValue('Identity','Avalonia.Skia')->'%(Version)')</_VelaAvaloniaSkiaPin>
			<_VelaAvaloniaEditPin>@(PackageVersion->WithMetadataValue('Identity','Avalonia.AvaloniaEdit')->'%(Version)')</_VelaAvaloniaEditPin>
		</PropertyGroup>
		<Error Condition="'$(_VelaAvaloniaPin)' == '' or '$(_VelaAvaloniaPin)' != '$(VelaAvaloniaVersion)'"
		       Code="VELAP1000"
		       Text="The test host Avalonia package is '$(_VelaAvaloniaPin)', but the target-host version is '$(VelaAvaloniaVersion)'." />
		<Error Condition="'$(_VelaAvaloniaHeadlessPin)' != '' and '$(_VelaAvaloniaHeadlessPin)' != '$(VelaAvaloniaVersion)'"
		       Code="VELAP1000"
		       Text="Avalonia.Headless '$(_VelaAvaloniaHeadlessPin)' does not match target-host Avalonia '$(VelaAvaloniaVersion)'." />
		<Error Condition="'$(_VelaAvaloniaThemesPin)' != '' and '$(_VelaAvaloniaThemesPin)' != '$(VelaAvaloniaVersion)'"
		       Code="VELAP1000"
		       Text="Avalonia.Themes.Fluent '$(_VelaAvaloniaThemesPin)' does not match target-host Avalonia '$(VelaAvaloniaVersion)'." />
		<Error Condition="'$(_VelaAvaloniaSkiaPin)' != '' and '$(_VelaAvaloniaSkiaPin)' != '$(VelaAvaloniaVersion)'"
		       Code="VELAP1000"
		       Text="Avalonia.Skia '$(_VelaAvaloniaSkiaPin)' does not match target-host Avalonia '$(VelaAvaloniaVersion)'." />
		<Error Condition="'$(_VelaAvaloniaEditPin)' != '' and '$(_VelaAvaloniaEditPin)' != '$(VelaAvaloniaEditVersion)'"
		       Code="VELAP1001"
		       Text="Avalonia.AvaloniaEdit '$(_VelaAvaloniaEditPin)' does not match target-host AvaloniaEdit '$(VelaAvaloniaEditVersion)'." />
	</Target>

	<Target Name="VerifyResolvedTargetHostAvalonia" AfterTargets="ResolveAssemblyReferences"
	        Condition="'$(VelaSkipAvaloniaVersionCheck)' != 'true'">
		<ItemGroup>
			<_VelaAvaloniaReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Avalonia'" />
			<_VelaAvaloniaEditReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Avalonia.AvaloniaEdit'" />
		</ItemGroup>
		<Error Condition="'@(_VelaAvaloniaReference)' != '' and '%(_VelaAvaloniaReference.NuGetPackageVersion)' != '$(VelaAvaloniaVersion)'"
		       Code="VELAP1000"
		       Text="This project resolves Avalonia %(_VelaAvaloniaReference.NuGetPackageVersion), but its target host uses $(VelaAvaloniaVersion)." />
		<Error Condition="'@(_VelaAvaloniaEditReference)' != '' and '%(_VelaAvaloniaEditReference.NuGetPackageVersion)' != '$(VelaAvaloniaEditVersion)'"
		       Code="VELAP1001"
		       Text="This project resolves AvaloniaEdit %(_VelaAvaloniaEditReference.NuGetPackageVersion), but its target host uses $(VelaAvaloniaEditVersion)." />
	</Target>
</Project>
