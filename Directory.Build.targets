<Project>
	<!-- 自定义任务来检查 TargetFramework 和 TargetFrameworks -->
	<Target Name="CheckTargetFramework" BeforeTargets="BeforeBuild" Condition="'$(UseWPF)' != 'true' and '$(UseWindowsForms)' != 'true' and '$(IsRoslynComponent)' != 'true'">
		<XmlPeek XmlInputPath="$(MSBuildProjectFullPath)" Query="//*[local-name()='TargetFramework' or local-name()='TargetFrameworks']">
			<Output TaskParameter="Result" ItemName="ExplicitTargetFramework" />
		</XmlPeek>
		<Error Condition="'@(ExplicitTargetFramework)' != ''" File="$(MSBuildProjectFullPath)" Text="在启用按文件夹自定义生成的情况下,已指定目标框架.项目文件中不应显式定义 TargetFramework 或 TargetFrameworks 属性,请删除." />
	</Target>

	<!--
	  Avalonia 版本与 SDK 锁的一致性核对。

	  拆库之后 Avalonia 版本的**权威在 velashell-plugin-sdk** —— VelaShell.PluginSdk.Build
	  用精确区间 [x.y.z] 锁给插件工程,VelaShell.PluginSdk 再把同一个值经 buildTransitive
	  导出成 $(VelaSdkPinnedAvaloniaVersion)。本仓库 Directory.Packages.props 里的
	  Avalonia* 只服务于**测试工程**(测试宿主要扮演装载方,得显式提供运行时那份)。

	  两边漂了会怎样:测试里 Avalonia 是 A 版、插件编译期看到的是 B 版,headless 会话里
	  控件类型对不上 —— 而这个现象与"插件装进真宿主后炸掉"长得一模一样,排查时很容易
	  怀疑到插件代码上去。所以在构建期直接拦住,给一句人话。

	  升 SDK 的动作因此是两步:在 VS 的 NuGet 包管理器里升 VelaShell.PluginSdk.Build,
	  然后按这里的报错把 Directory.Packages.props 的三个 Avalonia* 跟上。

	  ⚠️ 基准直接从 CPM 的 PackageVersion 上读回来,不再在 Directory.Build.props 里
	     另存一份属性副本 —— Version="$(...)" 会让包管理器认不出这条依赖。
	-->
	<Target Name="VerifyAvaloniaMatchesSdk" BeforeTargets="BeforeBuild"
	        Condition="'$(VelaSdkPinnedAvaloniaVersion)' != ''">
		<PropertyGroup>
			<_VelaAvaloniaPin>@(PackageVersion->WithMetadataValue('Identity','Avalonia')->'%(Version)')</_VelaAvaloniaPin>
		</PropertyGroup>
		<Error Condition="'$(_VelaAvaloniaPin)' != '' and '$(VelaSdkPinnedAvaloniaVersion)' != '$(_VelaAvaloniaPin)'"
		       Code="VELAP1000"
		       Text="Avalonia 版本与 SDK 锁的不一致:VelaShell.PluginSdk $(VelaSdkPackageVersion) 锁的是 $(VelaSdkPinnedAvaloniaVersion),而本仓库 Directory.Packages.props 里的 Avalonia 是 $(_VelaAvaloniaPin)。把 Directory.Packages.props 里三个 Avalonia* 都改成 $(VelaSdkPinnedAvaloniaVersion)。" />
	</Target>
</Project>
